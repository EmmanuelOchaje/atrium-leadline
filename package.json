{
  "name": "leadline",
  "version": "0.0.0",
  "description": "Leadline - Uniswap v4 hook for token market-making governance",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "contracts:fmt": "cd contracts && forge fmt",
    "contracts:clean": "cd contracts && forge clean",
    "web:dev": "pnpm -C apps/web dev",
    "web:build": "pnpm -C apps/web build",
    "web:lint": "pnpm -C apps/web lint",
    "web:typecheck": "pnpm -C apps/web typecheck",
    "bots:mm": "pnpm -C bots exec tsx mm.ts",
    "bots:flow": "pnpm -C bots exec tsx flow.ts",
    "bots:attacks": "pnpm -C bots exec tsx attacks.ts"
  },
  "devDependencies": {
    "pnpm": "^9.0.0"
  }
}
